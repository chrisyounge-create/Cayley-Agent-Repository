stab := function(i)
  local R, S, K, Km, St;
  R := samples[i][1]; S := OnSubspacesByCanonicalBasis(samples[i][2], One(Gm));
  K := Stabilizer(G, R, OnSets); Km := Image(hom, K);
  St := Stabilizer(Km, S, OnSubspacesByCanonicalBasis);
  return [Size(K), Size(St)];
end;;
